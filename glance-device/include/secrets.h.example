#define WIFI_SSID "your-network"
#define WIFI_PASSWORD "your-password"

// The Glance server. Use its IP, not its .local name: resolving mDNS costs
// awake time on every wake. Give the server a fixed address (DHCP reservation).
#define GLANCE_URL "http://SERVER-IP:8080/glance.g2"
